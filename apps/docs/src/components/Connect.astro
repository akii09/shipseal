---
/**
 * A quiet link in the footer that reveals the author's profiles on hover or focus.
 * Deliberately small: the site is about the tool, not the person who wrote it.
 */
const links = [
  { label: "GitHub", href: "https://github.com/akii09" },
  { label: "X", href: "https://x.com/akashpise588" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/akashpise/" },
  { label: "Website", href: "https://www.akashpise.dev/" },
];
---
<div class="connect">
  <button class="trigger" aria-expanded="false" aria-controls="connect-pop">
    Liked the work? Let's connect
  </button>
  <div class="pop" id="connect-pop" role="group" aria-label="Author profiles">
    {links.map((l) => (
      <a href={l.href} rel="me noopener" target="_blank">{l.label}</a>
    ))}
  </div>
</div>

<style>
  .connect { position: relative; display: inline-block; }
  .trigger {
    background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; font-size: 0.85rem; color: var(--muted);
    border-bottom: 1px dashed #33333a; transition: color 0.15s ease;
  }
  .trigger:hover, .connect:focus-within .trigger { color: var(--fg); }

  .pop {
    position: absolute; bottom: calc(100% + 0.65rem); left: 0;
    display: flex; gap: 0.15rem; padding: 0.35rem;
    background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 12px; box-shadow: 0 18px 40px -24px rgb(0 0 0 / 1);
    opacity: 0; visibility: hidden; transform: translateY(5px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    white-space: nowrap;
  }
  .connect:hover .pop, .connect:focus-within .pop {
    opacity: 1; visibility: visible; transform: none;
  }
  .pop a {
    font-size: 0.82rem; color: var(--muted); text-decoration: none;
    padding: 0.35rem 0.6rem; border-radius: 8px; transition: background 0.12s ease, color 0.12s ease;
  }
  .pop a:hover { background: #26262b; color: var(--fg); }

  @media (max-width: 560px) { .pop { left: auto; right: 0; } }
</style>
