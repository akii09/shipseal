---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;

const nav = [
  {
    group: "Start",
    items: [
      { href: "/docs/quick-start", label: "Quick start" },
      { href: "/docs/github-action", label: "GitHub Action" },
    ],
  },
  {
    group: "Reference",
    items: [
      { href: "/docs/cli", label: "CLI commands" },
      { href: "/docs/brand", label: "Brand kit" },
      { href: "/docs/config", label: "Configuration" },
      { href: "/docs/templates", label: "Templates" },
      { href: "/docs/manifest", label: "Manifest" },
    ],
  },
  {
    group: "More",
    items: [
      { href: "/ai", label: "For agents" },
      { href: "/docs/faq", label: "FAQ" },
    ],
  },
];
const here = Astro.url.pathname.replace(/\/$/, "");
---

<Base title={title} description={description}>
  <div class="wrap shell">
    <aside>
      <details class="mobilenav">
        <summary>Documentation menu</summary>
      </details>
      <nav>
        {nav.map((g) => (
          <div class="group">
            <p class="glabel">{g.group}</p>
            <ul>
              {g.items.map((i) => (
                <li>
                  <a href={i.href} class={here === i.href ? "on" : ""} aria-current={here === i.href ? "page" : undefined}>
                    {i.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article class="prose">
      <h1>{heading}</h1>
      <slot />
    </article>
  </div>

  <style>
    /* minmax(0, 1fr), not 1fr: a bare track takes its minimum from the widest unbreakable
       content, so a long line in a code block widened the whole page instead of scrolling
       inside its own pre. The 900px rule below already had this right. */
    .shell { display: grid; gap: clamp(2rem, 5vw, 3.5rem); padding-block: clamp(2.5rem, 5vw, 3.5rem); grid-template-columns: minmax(0, 1fr); align-items: start; }
    @media (min-width: 900px) { .shell { grid-template-columns: 212px minmax(0, 1fr); } }

    aside { position: sticky; top: 82px; }
    .mobilenav { display: none; }
    .mobilenav summary {
      cursor: pointer; list-style: none; font-size: 0.92rem; font-weight: 600;
      padding: 0.7rem 0.9rem; border: 1px solid var(--line); border-radius: 10px;
      background: var(--surface); display: flex; justify-content: space-between; align-items: center;
    }
    .mobilenav summary::-webkit-details-marker { display: none; }
    .mobilenav summary::after { content: "+"; color: var(--muted); font-family: var(--mono); }
    .mobilenav[open] summary::after { content: "\2212"; }

    /* Under 900px the sidebar is a disclosure, so it stops eating a whole screen. */
    @media (max-width: 899px) {
      aside { position: static; }
      .mobilenav { display: block; }
      aside nav { display: none; padding-top: 1rem; }
      aside:has(.mobilenav[open]) nav { display: block; }
    }
    .group + .group { margin-top: 1.6rem; }
    .glabel { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.09em; text-transform: uppercase; color: #5e5e66; margin-bottom: 0.55rem; }
    aside ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
    aside a { display: block; padding: 0.35rem 0.6rem; margin-left: -0.6rem; border-radius: 8px; color: var(--muted); text-decoration: none; font-size: 0.92rem; transition: background 0.12s ease, color 0.12s ease; }
    aside a:hover { color: var(--fg); background: var(--surface); }
    aside a.on { color: var(--fg); background: var(--surface-2); font-weight: 600; }

    .prose { max-width: 46rem; }
    .prose :global(h1) { font-size: clamp(2rem, 4.5vw, 2.9rem); }
    .prose :global(h2) { font-size: 1.45rem; margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }
    .prose :global(h3) { font-size: 1.08rem; margin-top: 2rem; }
    .prose :global(p) { margin-top: 1.1rem; color: #c4c4cc; }
    .prose :global(ul), .prose :global(ol) { margin-top: 1.1rem; padding-left: 1.2rem; color: #c4c4cc; }
    .prose :global(li) { margin-top: 0.45rem; }
    .prose :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
    .prose :global(pre) { margin-top: 1.3rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.05rem 1.15rem; overflow-x: auto; font-size: 0.85rem; line-height: 1.7; color: #cfcfd8; }
    /* overflow-wrap: anywhere lets a long inline token (a path, a command) break rather than
       set the minimum width of the page. break-word would not: it does not affect min-content. */
    .prose :global(:not(pre) > code) { background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; padding: 0.1rem 0.35rem; color: var(--accent); overflow-wrap: anywhere; }
    .prose :global(table) { width: 100%; border-collapse: collapse; margin-top: 1.3rem; font-size: 0.92rem; display: block; overflow-x: auto; }
    .prose :global(th), .prose :global(td) { text-align: left; padding: 0.6rem 0.9rem 0.6rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
    .prose :global(th) { font-family: var(--mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; color: #5e5e66; font-weight: 500; }
    .prose :global(.callout) { margin-top: 1.4rem; border-left: 2px solid var(--primary); background: #141013; border-radius: 0 10px 10px 0; padding: 0.9rem 1.1rem; font-size: 0.93rem; color: #c4c4cc; }
    .prose :global(.callout strong) { color: var(--fg); }
  </style>
  <script>
    // Add a copy button to every code block on a docs page.
    for (const pre of document.querySelectorAll<HTMLElement>(".prose pre")) {
      const wrap = document.createElement("div");
      wrap.className = "copywrap";
      pre.replaceWith(wrap);
      wrap.append(pre);
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.trim());
          button.textContent = "Copied";
          button.dataset.copied = "";
          setTimeout(() => {
            button.textContent = "Copy";
            delete button.dataset.copied;
          }, 1600);
        } catch {
          button.textContent = "Press Cmd C";
        }
      });
      wrap.append(button);
    }
  </script>
</Base>
