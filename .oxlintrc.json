{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import", "promise", "node", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    // AGENTS.md: no `any`, no casts that silence the compiler.
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // AGENTS.md security rules: no eval, no dynamic code execution.
    "no-eval": "error",
    "no-implied-eval": "error",
    "unicorn/prefer-node-protocol": "error",
    // Re-enabled once the last generated stub in src/ was implemented and the scaffold that
    // produced them was removed. Both guard against a module that exports nothing by accident.
    "unicorn/require-module-specifiers": "error",
    "unicorn/no-empty-file": "error"
  },
  "ignorePatterns": [
    // Astro components: a bare CSS import is the documented way to load global styles,
    // and oxlint parses .astro frontmatter as plain JS, so its findings there are noise.
    "**/*.astro","**/dist/**", "**/coverage/**", "**/node_modules/**", "spikes/**"]
}
